#!/usr/bin/env bash
# ken-cargo — run cargo under a machine-wide build lock so that N parallel agents
# don't oversubscribe CPU or OOM the box during compilation/linking.
#
# Usage:  ken-cargo build -p ken-kernel
#         ken-cargo test  -p ken-kernel
# Agents MUST build/test through this wrapper, never raw `cargo build` (see
# COORDINATION.md §12 and docs/ops/compute-budget.md).
#
# Concurrency: KEN_BUILD_SLOTS (default 1) = how many cargo invocations may run
# at once machine-wide. 1 is correct for an 8-core / 16 GB laptop (one build at a
# time, with -j from .cargo/config.toml). Raise it as hardware grows.
set -euo pipefail

slots="${KEN_BUILD_SLOTS:-1}"

# Build scratch goes on the repo volume, not the container's /tmp.
#
# /tmp here is a 7.8G tmpfs shared with everything else on the box; the
# ken-runtime suites leave tens of MB of scratch per run and exhaust it. When
# they do, the linker fails with "No space left on device" and those rows land
# in a test report looking like semantic failures — that misreading has cost
# this project real time twice. The repo volume has room, and TMPDIR is what
# `std::env::temp_dir()`, rustc, and the linker all read.
#
# KEN_TMPDIR overrides (CI sets its own runner temp).
# Only redirect when the parent volume actually exists, so this is a no-op on a
# CI runner (which has its own ample temp) rather than creating a stray
# directory at the filesystem root.
ken_tmpdir="${KEN_TMPDIR:-/workspaces/ken/tmp}"
if [[ -d "$(dirname "$ken_tmpdir")" ]] && mkdir -p "$ken_tmpdir" 2>/dev/null; then
  export TMPDIR="$ken_tmpdir"
fi

# The build mutex must NOT follow TMPDIR. Two seats that resolve different lock
# paths each acquire "the" lock and then build concurrently, which is the exact
# oversubscription this wrapper exists to prevent. Pin it to a fixed path.
lockdir="${KEN_LOCK_DIR:-/tmp/ken-build-locks}"
mkdir -p "$lockdir"

run() { cargo "$@" 9>&-; }

# Preferred: GNU `sem` gives a correct counting semaphore for slots > 1.
if [[ "$slots" -gt 1 ]] && command -v sem >/dev/null 2>&1; then
  exec sem --id ken-build --fg -j "$slots" -- cargo "$@"
fi

# Default path: a single flock mutex (slots == 1, or no `sem` available).
# Acquire fd 9 on a lock file; block until free, then run cargo holding the lock.
exec 9>"$lockdir/build.lock"
if ! flock -w "${KEN_BUILD_WAIT:-1800}" 9; then
  echo "ken-cargo: timed out waiting for the build lock ($lockdir/build.lock)" >&2
  exit 1
fi
run "$@"
