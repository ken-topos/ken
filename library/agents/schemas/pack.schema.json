{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library/agents/schemas/pack.schema.json",
  "title": "Ken agent context pack",
  "type": "object",
  "required": [
    "schema_version", "id", "purpose", "triggers", "exclusions",
    "dependencies", "includes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "exclusions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "includes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(core|tasks)/[a-z0-9-]+$"},
      "minItems": 1
    }
  },
  "additionalProperties": false
}
