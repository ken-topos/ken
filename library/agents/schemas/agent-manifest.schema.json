{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library/agents/schemas/agent-manifest.schema.json",
  "title": "Ken agent module and pack manifest",
  "type": "object",
  "required": ["schema_version", "revision", "measurement", "module", "pack"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "measurement": {"const": "unicode-whitespace-v1"},
    "module": {
      "type": "array",
      "items": {"$ref": "#/$defs/module"},
      "minItems": 1
    },
    "pack": {
      "type": "array",
      "items": {"$ref": "#/$defs/pack"},
      "minItems": 1
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": [
        "id", "path", "purpose", "triggers", "prerequisites", "sources",
        "revision", "validation", "measured_tokens"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(core|tasks)/[a-z0-9-]+$"},
        "path": {"type": "string", "pattern": "^library/agents/(core|tasks)/.*\\.md$"},
        "purpose": {"type": "string", "minLength": 1},
        "triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "validation": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "measured_tokens": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "required": [
        "id", "path", "purpose", "triggers", "exclusions", "includes",
        "dependencies", "revision", "validation", "measured_tokens"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "path": {"type": "string", "pattern": "^library/agents/packs/.*\\.toml$"},
        "purpose": {"type": "string", "minLength": 1},
        "triggers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "exclusions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "includes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "validation": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "measured_tokens": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
